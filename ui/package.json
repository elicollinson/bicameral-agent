{
  "name": "bicameral-ui",
  "version": "0.1.0",
  "private": true,
  "description": "React Ink terminal console for launching, tracking, and reviewing bicameral-agent benchmark runs",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "tsx src/cli.tsx",
